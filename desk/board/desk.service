[Unit]
Description=desk: page, files and commands for this board
After=network.target user@__UID__.service

[Service]
User=__USER__
WorkingDirectory=__DIR__
# so volume commands (pactl) reach the user's PipeWire, as on symbios
Environment=XDG_RUNTIME_DIR=/run/user/__UID__
# the standard web port, so the address is just http://__NAME__.local
AmbientCapabilities=CAP_NET_BIND_SERVICE
# the Terminal's real shell: on the board's own screen and over the USB cable, never the WiFi
ExecStart=/usr/bin/python3 __DIR__/server.py --home __HOME__ --ptilu __PTILU__ --allow all --shell 127.0.0.0/8,10.55.0.0/24 --port 80
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
